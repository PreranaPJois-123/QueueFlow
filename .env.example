# Copy to .env in the project root, then: docker compose up -d --build
# Never commit a populated .env. Generate secrets with openssl (hex is URL-safe):
#   openssl rand -hex 32   (JWT_SECRET_KEY)
#   openssl rand -hex 24   (POSTGRES_PASSWORD, APP_DB_PASSWORD)

# --- Required secrets ---
JWT_SECRET_KEY=            # signs nothing user-visible now; keys session/reset-token digests
POSTGRES_PASSWORD=         # PostgreSQL superuser (init, backups); the app never uses it
APP_DB_PASSWORD=           # least-privilege role the backend connects as

# --- Public origin the browser uses (nginx serves the SPA and proxies /api) ---
#   Local:  http://localhost:8080     EC2 demo: http://<elastic-ip>     Production: https://your.domain
VITE_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080
FRONTEND_BIND=0.0.0.0      # 127.0.0.1 when a host TLS proxy (e.g. Caddy) fronts nginx
# Session cookies are marked Secure when true; requires HTTPS. Use false only for plain-HTTP local/demo.
COOKIE_SECURE=false

# --- Demo data: fictional, clearly labelled "Sample" venues ---
SEED_SAMPLE_DATA=true

# --- First administrator (created once if no admin exists; remove the password afterwards) ---
# Password policy: 10-128 chars, a letter and a number, must not contain the email name.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# --- Optional: email for password reset (nothing is sent if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional: Wayzen AI. Unset LLM_* = limited mode (cited help articles, no generated text) ---
# LLM_PROVIDER: anthropic | openai_compatible (OpenAI, Ollama, vLLM, LM Studio, ...)
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=              # e.g. http://host.docker.internal:11434/v1 for Ollama; empty = provider default
LLM_API_KEY=
# EMBEDDING_PROVIDER: local (offline lexical hashing, default) | openai_compatible (semantic)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
