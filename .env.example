# Copy this to .env in the project root before running `docker compose up --build`.
# Never commit a populated .env. Generate secrets with openssl (hex keeps URLs safe):
#   JWT_SECRET_KEY:    openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 24
JWT_SECRET_KEY=
POSTGRES_PASSWORD=

# Public origin the browser uses. The frontend nginx proxies /api to the backend,
# so the API URL and CORS origin are the same value.
#   Local:  http://localhost:8080   (FRONTEND_PORT=8080)
#   EC2:    http://<elastic-ip>     (FRONTEND_PORT=80)
VITE_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080

# Optional: create the first ADMIN on startup if none exists. Remove the password
# after the first successful login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
